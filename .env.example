# Copy this file to `.env` and fill in real values. `.env` is gitignored — never commit it.

# Required in production. Signs/verifies login JWTs (30-day expiry). If unset, the server
# falls back to an insecure hardcoded default (see src/server/auth.ts) and logs a warning.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# development | production. Also controls which SQLite file is used (game.dev.db vs game.db).
NODE_ENV=development

# Optional. If set, players must supply this code (via JOIN_LOBBY) to connect at all — an
# extra gate on top of login, for keeping the server private beyond friends who have the code.
# Leave blank to disable.
PARTY_CODE=
