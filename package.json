{
  "name": "halls-of-torment-coop",
  "version": "1.0.0",
  "description": "4-Player Co-op Dark Fantasy Horde Survival Game",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "tsx src/server/server.ts",
    "server:prod": "cross-env NODE_ENV=production tsx src/server/server.ts",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "validate:skilltree": "tsx scripts/validateSkillTree.ts",
    "tunnel": "npx cloudflared tunnel --url http://localhost:3000",
    "tunnel:windows": "tools\\cloudflared.exe tunnel --url http://localhost:3000"
  },
  "dependencies": {
    "serve-static": "^2.2.1",
    "three": "^0.170.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/serve-static": "^2.2.0",
    "@types/three": "^0.170.0",
    "@types/ws": "^8.5.13",
    "cross-env": "^10.1.0",
    "puppeteer-core": "^25.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.1",
    "vitest": "^5.0.0"
  }
}
